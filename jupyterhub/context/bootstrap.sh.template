#!/bin/bash
set -euo pipefail

# Adapted from Bootstrap example script
# Copyright (c) Jupyter Development Team.
# Distributed under the terms of the Modified BSD License.

# - The first parameter for the Bootstrap Script is the USER.
USER=$1
if [ "$USER" == "" ]; then
    exit 1
fi

# Start the Bootstrap Process
echo "bootstrap process running for user $USER ..."

# Base Directory: All user directories live under /srv/jupyterhub so that they are mounted
# into the single-user containers via DockerSpawner volumes.
BASE_DIRECTORY=${JH_USER_BASE:-/srv/jupyterhub}

# User Directory: That's the private directory for the user to be created, if none exists
USER_DIRECTORY=$BASE_DIRECTORY/$USER
if [ ! -d "$USER_DIRECTORY" ]; then
    mkdir -p "$USER_DIRECTORY"
fi
chown 1000:100 "$USER_DIRECTORY"

# Clean up legacy symlinks/files (pyproject, repo mirrors, etc.)
for legacy in "How To Do Stuff.md" pyproject.toml spyglass scripts POP map_ephys "Spyglass Notebooks" "BAM Book Materials"; do
    TARGET="$USER_DIRECTORY/$legacy"
    if [ -L "$TARGET" ]; then
        rm -f "$TARGET"
    elif [ -e "$TARGET" ]; then
        rm -rf "$TARGET"
    fi
done

# Ensure minimal footprint: only create notebooks folder for new users
NOTEBOOKS_DIR="$USER_DIRECTORY/notebooks"
if [ -L "$NOTEBOOKS_DIR" ]; then
    rm -rf "$NOTEBOOKS_DIR"
fi
if [ ! -d "$NOTEBOOKS_DIR" ]; then
    mkdir -p "$NOTEBOOKS_DIR"
    
    # Create README on first launch explaining the defense-in-depth setup
    cat > "$NOTEBOOKS_DIR/README.md" <<'EOF'
# Welcome to Your BAM Workspace

This `~/notebooks/` directory contains **editable copies** of template notebooks.

## Defense-in-Depth Strategy

**Your Workspace (Read-Write)**
- `~/notebooks/` - Personal notebook copies (edit freely, changes persist)
- `~/shared_data/` - Collaborative workspace (share files with other users)

**Read-Only Resources**
- `/srv/bam-resources/tj-repo/docs/book/` - Template notebooks (pristine source)
- `/srv/bam-resources/tj-repo/scripts/` - Analysis scripts and utilities
- `/mnt/raid5/datasets/` - NWB files and DANDI datasets

## Workflow

1. **Explore**: Run notebooks in `~/notebooks/` 
2. **Analyze**: Access data at `/mnt/raid5/datasets/`
3. **Collaborate**: Share results via `~/shared_data/`
4. **Improve**: Submit pull requests to update templates at `/srv/bam-resources/tj-repo/`

## Synchronization

- **Template updates**: Notebooks are re-synced from templates on each login
- **Your changes**: Modifications to `~/notebooks/` persist across sessions
- **Fresh start**: Delete a notebook to get the latest template on next login

For help, see `~/HowTo.md` or contact the BAM team.
EOF
fi
chown 1000:100 "$NOTEBOOKS_DIR"

RESOURCES_ROOT=/srv/bam-resources
BOOK_NOTEBOOKS=(
    "explore_data/session_browser.ipynb:session_browser.ipynb"
)

# Copy/update template notebooks (defense in depth)
# Users get editable copies; source templates remain read-only
for entry in "${BOOK_NOTEBOOKS[@]}"; do
    IFS=':' read -r src relative <<<"$entry"
    SRC_PATH="${RESOURCES_ROOT}/bam-book/${src}"
    DEST_PATH="${NOTEBOOKS_DIR}/${relative}"
    if [ -f "$SRC_PATH" ]; then
        # Only update if source is newer or dest doesn't exist
        if [ ! -f "$DEST_PATH" ] || [ "$SRC_PATH" -nt "$DEST_PATH" ]; then
            echo "Syncing template notebook ${relative} for $USER"
            cp "$SRC_PATH" "$DEST_PATH"
            chown 1000:100 "$DEST_PATH"
            chmod u+rw "$DEST_PATH"
        fi
    fi
done

SECRET_SOURCE=${DJ_PASSWORD_SRC:-/run/secrets/dj_password}
DEST_SECRET="$USER_DIRECTORY/.dj_password"
if [ -f "$SECRET_SOURCE" ]; then
    echo "Syncing database password secret for $USER"
    cp "$SECRET_SOURCE" "$DEST_SECRET"
    chown 1000:100 "$DEST_SECRET"
    chmod 600 "$DEST_SECRET"
fi

exit 0
